% TikZit-format style sheet.
% Rules:
%   - one self-contained line per style (no inheritance)
%   - simple arrow tips (>=stealth or >=latex)
%   - no \footnotesize / \itshape / align inside styles
%   - colors stay as named or xcolor mixes; TikZit understands black!12 etc.

\tikzstyle{existing}  =[draw, thick, fill=black!12, rectangle, rounded corners, minimum width=4cm, minimum height=1.4cm, inner sep=4pt]
\tikzstyle{newcomp}   =[draw, thick, fill=blue!18,  rectangle, rounded corners, minimum width=4cm, minimum height=1.4cm, inner sep=4pt]
\tikzstyle{storage}   =[draw, thick, fill=orange!28,rectangle, rounded corners, minimum width=4cm, minimum height=1.4cm, inner sep=4pt]
\tikzstyle{smnew}     =[draw, thick, fill=blue!18,  rectangle, rounded corners, minimum width=3cm, minimum height=1.6cm, inner sep=4pt]
\tikzstyle{hook}      =[draw, thick, fill=yellow!55,rectangle, rounded corners, minimum width=5.5cm, minimum height=1.4cm, inner sep=4pt]
\tikzstyle{iface}     =[draw, thick, fill=black!12, rectangle, rounded corners, minimum width=5.5cm, minimum height=1.4cm, inner sep=4pt]
\tikzstyle{detail}    =[draw, dashed, fill=white,   rectangle, rounded corners, minimum width=4cm, minimum height=1.4cm, inner sep=4pt]

\tikzstyle{flow}      =[->, thick, >=stealth]
\tikzstyle{sibling}   =[<->, dashed, thick, >=stealth, color=black!55]
\tikzstyle{lbl}       =[fill=white, draw=black!30, rectangle, rounded corners, inner sep=2pt]
