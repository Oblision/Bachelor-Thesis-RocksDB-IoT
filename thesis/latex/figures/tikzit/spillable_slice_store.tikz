\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=iface]    (iface)        at (2.5,   0)    {WindowSlicesStoreInterface};
		\node [style=hook]     (lower)        at (2.5,  -2.5)  {LowerToPhysicalWindowedAggregation};
		\node [style=existing] (handler)      at (13,    0)    {WindowBasedOperatorHandler};

		\node [style=existing] (defstore)     at (-1,   -5)    {DefaultTimeBasedSliceStore};
		\node [style=existing] (aggslice)     at (-1,   -7.5)  {AggregationSlice};
		\node [style=existing] (hmaps)        at (-1,  -10)    {HashMap 0..N-1};
		\node [style=existing] (chained)      at (-1,  -12.5)  {ChainedHashMap};

		\node [style=newcomp]  (spillstore)   at (6,    -5)    {SpillableTimeBasedSliceStore};
		\node [style=newcomp]  (spillslice)   at (6,    -7.5)  {SpillableAggregationSlice};
		\node [style=smnew]    (buildpath)    at (4,   -10)    {Build path};
		\node [style=smnew]    (probepath)    at (8,   -10)    {Probe path};
		\node [style=newcomp]  (backendiface) at (6,   -12.5)  {SpillBackend};
		\node [style=storage]  (rocks)        at (6,   -15)    {RocksDBSpillBackend};

		\node [style=newcomp]  (cfg)          at (13,   -5)    {SpillConfig};
		\node [style=newcomp]  (budget)       at (13,   -7.5)  {MemoryBudgetTracker};
		\node [style=existing] (bufmgr)       at (13,  -10)    {BufferManager};
		\node [style=existing] (wm)           at (13,  -12.5)  {Stream Watermark};
		\node [style=detail]   (cfgdetail)    at (13,  -15)    {SpillConfig fields};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=flow] (iface)         to (lower);
		\draw [style=flow] (lower)         to (defstore);
		\draw [style=flow] (lower)         to (spillstore);
		\draw [style=flow] (handler)       to (lower);

		\draw [style=flow] (defstore)      to (aggslice);
		\draw [style=flow] (aggslice)      to (hmaps);
		\draw [style=flow] (hmaps)         to (chained);

		\draw [style=flow] (spillstore)    to (spillslice);
		\draw [style=flow] (spillslice)    to (buildpath);
		\draw [style=flow] (spillslice)    to (probepath);
		\draw [style=flow] (buildpath)     to (backendiface);
		\draw [style=flow] (probepath)     to (backendiface);
		\draw [style=flow] (backendiface)  to (rocks);

		\draw [style=sibling] (aggslice)   to (spillslice);

		\draw [style=flow] (cfg)           to (spillstore);
		\draw [style=flow] (budget)        to (spillslice);
		\draw [style=flow] (bufmgr)        to (budget);
		\draw [style=flow] (wm)            to (probepath);
	\end{pgfonlayer}
\end{tikzpicture}
